---
import BaseLayout from "./BaseLayout.astro";

const { title, description } = Astro.props;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": title
  }
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <article>
    <slot />
  </article>
</BaseLayout>