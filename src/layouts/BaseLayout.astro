---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  robots?: string;
  ogImage?: string;
  schemaType?: 'Article' | 'Course' | 'EducationalOrganization';
  schemaData?: Record<string, any>;
}

const { 
  title, 
  description, 
  canonical, 
  robots = 'index, follow',
  ogImage,
  schemaType,
  schemaData = {}
} = Astro.props;

const site = 'https://www.stem-online.hr';
const path = Astro.url.pathname;
const canonicalUrl = canonical || `${site}${path}`;

const fullTitle = `${title} – STEM Online`;

let jsonLd: Record<string, any> | null = null;

if (schemaType) {
  if (schemaType === 'Article') {
    jsonLd = {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalUrl,
      },
      ...schemaData,
    };
  } else if (schemaType === 'Course') {
    jsonLd = {
      '@context': 'https://schema.org',
      '@type': 'Course',
      name: title,
      description,
      url: canonicalUrl,
      ...schemaData,
    };
  } else if (schemaType === 'EducationalOrganization') {
    jsonLd = {
      '@context': 'https://schema.org',
      '@type': 'EducationalOrganization',
      name: title,
      description,
      url: canonicalUrl,
      ...schemaData,
    };
  }
}
---

<!DOCTYPE html>
<html lang="hr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={robots} />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  {jsonLd && (
    <script type="application/ld+json">
      {JSON.stringify(jsonLd)}
    </script>
  )}
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: system-ui, sans-serif; background-color: #f5f0e8; color: #2d2d2d; }
   header, footer { background-color: #1a2e2a; color: white; padding: 1rem 2rem; display: block; }
    main { max-width: 1280px; margin: 0 auto; padding: 2rem 1rem; min-height: 60vh; }
  </style>
</head>
<body>
  <header>
    <a href="/" style="color: white; text-decoration: none; font-weight: bold;">STEM Online</a>
  </header>
  <main>
    <slot />
  </main>
  <footer>
    <p>© 2026 STEM Online. Sva prava pridržana.</p>
  </footer>
</body>
</html>