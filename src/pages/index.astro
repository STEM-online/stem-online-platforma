---
import BaseLayout from '../layouts/BaseLayout.astro';

const websiteSchema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "STEM Online",
    "url": "https://www.stem-online.hr",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://www.stem-online.hr/search?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  }
];
---

<BaseLayout
  title="STEM Online - Online instrukcije iz matematike, fizike i kemije"
  description="Pronađi kvalitetne online instrukcije iz matematike, fizike i kemije."
  url="https://www.stem-online.hr"
  schema={websiteSchema}
>
  <h1>Dobrodošli na STEM Online</h1>
</BaseLayout>