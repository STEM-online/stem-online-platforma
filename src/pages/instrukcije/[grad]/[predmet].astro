---
import CityLayout from "../../../layouts/CityLayout.astro";

const { grad, predmet } = Astro.params;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Početna",
      "item": "https://www.stem-online.hr/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Instrukcije",
      "item": "https://www.stem-online.hr/instrukcije"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": grad,
      "item": `https://www.stem-online.hr/instrukcije/${grad}`
    },
    {
      "@type": "ListItem",
      "position": 4,
      "name": predmet,
      "item": `https://www.stem-online.hr/instrukcije/${grad}/${predmet}`
    }
  ]
};
---

<CityLayout
  city={grad}
  schema={[breadcrumbSchema]}
>
  <h1>{predmet} instrukcije u {grad}</h1>
</CityLayout>