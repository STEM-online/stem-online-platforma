---
import CityLayout from "../../../layouts/CityLayout.astro";
import Map from "../../../components/interactive/Map.astro";

export function getStaticPaths() {
  const gradovi = [
    "zagreb", "split", "sisak", "osijek", "slavonski-brod"
  ];

  return gradovi.map(grad => ({
    params: { grad }
  }));
}

const { grad } = Astro.params;
---

<CityLayout city={grad}>

  <h1>Instrukcije u {grad}</h1>

  <Map city={grad}/>

</CityLayout>